{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numeralform.gold/schemas/review-case.schema.json",
  "title": "Numeralform blind review case",
  "type": "object",
  "required": [
    "review_schema_version",
    "case_id",
    "language",
    "locale",
    "input",
    "mode",
    "grammar",
    "family_id",
    "reviewer_slot",
    "annotation",
    "review"
  ],
  "properties": {
    "review_schema_version": { "const": "1.0.0" },
    "case_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "locale": { "type": ["string", "null"] },
    "input": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "integer" },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "mode": { "const": "cardinal" },
    "grammar": { "type": "object" },
    "family_id": { "type": "string", "minLength": 1 },
    "reviewer_slot": { "enum": ["A", "B"] },
    "annotation": { "type": ["null", "object"] },
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "const": "unreviewed" } },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
