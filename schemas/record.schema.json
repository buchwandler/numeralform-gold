{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/numeralform-gold/record.schema.json",
  "title": "Numeralform Gold record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "language",
    "locale",
    "input",
    "mode",
    "grammar",
    "oracle",
    "quality",
    "source_observations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^nfg-[a-z0-9-]+-[0-9a-f]{20}$" },
    "language": { "type": "string", "minLength": 2 },
    "locale": { "type": ["string", "null"] },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["integer", "decimal", "fraction"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "mode": {
      "enum": ["cardinal", "ordinal", "ordinal_num", "year", "currency"]
    },
    "grammar": {
      "type": "object",
      "properties": {
        "context": { "type": ["string", "null"] },
        "case": { "type": ["string", "null"] },
        "gender": { "type": ["string", "null"] },
        "grammatical_number": { "type": ["string", "null"] },
        "animacy": { "type": ["string", "null"] }
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "accepted", "rejected"],
      "properties": {
        "canonical": { "type": "string", "minLength": 1 },
        "accepted": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rejected": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "quality": { "enum": ["gold", "reference", "quarantine"] },
    "source_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["benchmark", "role", "source_id"],
        "properties": {
          "benchmark": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "source_version": { "type": ["string", "null"] },
          "source_url": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "generator": { "type": "object", "additionalProperties": true },
    "notes": { "type": "string" }
  }
}
