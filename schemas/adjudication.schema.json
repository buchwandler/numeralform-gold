{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numeralform.gold/schemas/adjudication.schema.json",
  "title": "Numeralform adjudication decision",
  "type": "object",
  "required": ["case_id", "adjudicator", "decision", "rationale", "evidence_used"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "adjudicator": {
      "type": "object",
      "required": ["adjudicator_id", "model_family"],
      "properties": {
        "adjudicator_id": { "type": "string", "minLength": 1 },
        "kind": { "const": "llm" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_family": { "type": "string", "minLength": 1 },
        "protocol_version": { "const": "numeral-review-v2" },
        "independence_group": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "decision": { "enum": ["accept", "exclude", "unresolved"] },
    "final_oracle": {
      "type": "object",
      "required": ["canonical", "accepted"],
      "properties": {
        "canonical": { "type": "string", "minLength": 1 },
        "accepted": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rejected": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Optional non-exhaustive negative evidence." }
      },
      "additionalProperties": false
    },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence_used": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocker": {
      "type": "object",
      "required": ["code", "class", "reason", "attempted_resolution", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "attempted_resolution": { "type": "string", "minLength": 1 },
        "retryable": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "accept" } } },
      "then": { "required": ["final_oracle"], "not": { "required": ["blocker"] } }
    },
    {
      "if": { "properties": { "decision": { "const": "unresolved" } } },
      "then": { "required": ["blocker"], "not": { "required": ["final_oracle"] } }
    },
    {
      "if": { "properties": { "decision": { "const": "exclude" } } },
      "then": { "not": { "required": ["final_oracle"] } }
    }
  ],
  "additionalProperties": false
}
